# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores.
# .env NUNCA se sube a git.
# Nada secreto lleva el prefijo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Base de datos (Supabase → Project Settings → Database → Connection string)
# App: pooler, puerto 6543
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones: conexión directa, puerto 5432
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API). Estas dos SÍ son públicas.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"

# URL pública de la app (en local: http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails — solo si el MVP envía alguno (resend.com)
# RESEND_API_KEY="re_xxxx"

# service_role de Supabase: se salta TODA la seguridad.
# Si no la necesitas, déjala fuera. Nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY="xxxx"
